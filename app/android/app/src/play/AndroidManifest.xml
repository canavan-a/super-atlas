<!-- The Google Play build (release/release-play.sh): merged over
     src/main/AndroidManifest.xml. No in-app updater and no always-on
     connection (Play allows neither): friend notifications come through
     Firebase Cloud Messaging. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="superatlas-friends" />

      <service
        android:name=".PlayMessagingService"
        android:exported="false">
        <intent-filter>
          <action android:name="com.google.firebase.MESSAGING_EVENT" />
        </intent-filter>
      </service>
    </application>
</manifest>
